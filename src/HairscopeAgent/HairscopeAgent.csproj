<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HairscopeAgent</AssemblyName>
    <RootNamespace>Hairscope.Agent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Version + file metadata stamped into HairscopeAgent.exe -->
    <Version>1.0.8</Version>
    <FileVersion>1.0.8.0</FileVersion>
    <AssemblyVersion>1.0.8.0</AssemblyVersion>
    <Company>Hairscope</Company>
    <Product>Hairscope Agent</Product>
    <Description>Detects the trichoscopy probe hardware button and relays it to the Hairscope web app.</Description>
    <Copyright>Copyright © Hairscope 2024</Copyright>
    <Authors>Hairscope</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hairscope/hairscope-windows-driver</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hairscope/hairscope-windows-driver</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Enable deterministic builds for reproducible signatures -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- USB device presence detection via WMI. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- Run the same binary as a console app (dev) or a Windows Service (prod). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Config is compiled INTO the binary as an embedded resource (not shipped as a
         loose, user-editable plaintext file). This keeps the security-sensitive origin
         allowlist and the device catalog out of the installed file tree. -->
    <EmbeddedResource Include="Config\devices.json" />
  </ItemGroup>

</Project>
