# .NET build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
x86/
x64/
*.user
*.suo

# Publish output
publish/
*.zip

# Installer: track source (.iss, scripts, brand assets); ignore build output
# and bundled third-party redistributables.
installer/Output/
installer/deps/

# Rider / VS
.vs/
.idea/

# Logs
*.log

# Archives / backups
*.rar

# Code signing - NEVER commit certificates or private keys
signing/*.pfx
signing/*.p12
signing/*.cer
signing/hairscope-*-code-sign.*
